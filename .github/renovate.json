{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "git-submodules": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true
  },
  "automerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": false,
  "recreateWhen": "always",
  "packageRules": [
    {
      "matchPackageNames": ["typescript", "typescript-eslint"],
      "groupName": "typescript"
    },
    {
      "description": "Jetson Orin (NVIDIA) libraries require Python 3.12",
      "matchPackageNames": ["python"],
      "allowedVersions": "<3.13"
    }
  ]
}
